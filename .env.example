# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback

# Flask Configuration
FLASK_SECRET_KEY=your_random_secret_key_here

# RapidAPI Key (for audio features - PRIMARY RECOMMENDATION ENGINE)
# Get this from: https://rapidapi.com/Glavier/api/track-analysis
# Subscribe to the free tier to get your API key
RAPID_API_KEY=your_rapidapi_key_here

# Last.fm API Credentials (fallback for music recommendations)
# Get these from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_API_SECRET=your_lastfm_api_secret_here
